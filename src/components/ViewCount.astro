---
/**
 * ViewCount - Umami Analytics를 이용한 개별 글 조회수 표시 컴포넌트
 * 빌드 타임에 서버사이드로 Umami API를 호출 (CORS 문제 없음, API Key 미노출)
 */
import IconEye from "@/assets/icons/IconEye.svg";
import { getPageViewCount } from "@/utils/umami";

type Props = {
  /** 조회수를 가져올 페이지 경로 (e.g., "/posts/my-post") */
  path: string;
  /** 크기 variant */
  size?: "sm" | "lg";
  class?: string;
};

const { path, size = "sm", class: className = "" } = Astro.props;
const viewCount = await getPageViewCount(path);
---

<span
  class:list={["view-count inline-flex items-center gap-x-1 opacity-80", className]}
>
  <IconEye
    class:list={[
      "inline-block size-5 min-w-4",
      { "scale-90": size === "sm" },
    ]}
  />
  <span
    class:list={["view-count-number text-sm", { "sm:text-base": size === "lg" }]}
    >{viewCount.toLocaleString()}</span
  >
</span>
