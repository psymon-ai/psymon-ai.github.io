---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import ViewCount from "./ViewCount.astro";

type Props = {
  variant?: "h2" | "h3";
  navContext?: "posts" | "series";
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  navContext = "posts",
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, ...props } = data;
const postPath = getPath(id, filePath);
const postHref = `${postPath}${navContext === "series" ? "?nav=series" : ""}`;
---

<li class="my-6">
  <a
    href={postHref}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <div class="flex items-center gap-3">
    <Datetime {...props} />
    <ViewCount path={postPath} size="sm" />
  </div>
  <p>{description}</p>
</li>
