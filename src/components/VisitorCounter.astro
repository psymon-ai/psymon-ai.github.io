---
/**
 * VisitorCounter - Umami Analytics를 이용한 총 방문자 수 + 오늘 방문자 수 표시
 * 빌드 타임에 서버사이드로 Umami API를 호출 (CORS 문제 없음, API Key 미노출)
 * Footer에 배치하여 사이트 전체 통계를 보여줌
 */
import IconUsers from "@/assets/icons/IconUsers.svg";
import { getSiteStats, getTodayStats } from "@/utils/umami";

const siteStats = await getSiteStats();
const todayStats = await getTodayStats();

const totalVisitors = siteStats.visitors || 0;
const todayVisitors = todayStats.visitors || 0;
---

<div class="visitor-counter flex items-center justify-center gap-4 text-sm opacity-70 my-2">
  <span class="inline-flex items-center gap-1">
    <IconUsers class="inline-block size-4" />
    <span>총 방문:</span>
    <span class="font-medium">{totalVisitors.toLocaleString()}</span>
  </span>
  <span class="text-muted">|</span>
  <span class="inline-flex items-center gap-1">
    <span>오늘:</span>
    <span class="font-medium">{todayVisitors.toLocaleString()}</span>
  </span>
</div>
