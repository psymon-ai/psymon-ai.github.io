{
  "Image (assets/images)": {
    "scope": "markdown",
    "prefix": ["!", "img", "image"],
    "body": ["![$1](@/assets/images/$1)"],
    "description": "이미지 삽입 - 파일명만 입력하면 alt와 경로에 동시에 반영",
    "isFileTemplate": true
  },
  "Frontmatter": {
    "scope": "markdown",
    "prefix": "frontmatter",
    "body": [
      "---",
      "author: $1",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:${CURRENT_SECOND}+09:00",
      "title: $2",
      "featured: ${3|false,true|}",
      "draft: ${4|false,true|}",
      "tags:",
      "  - $5",
      "keywords:",
      "  - $6",
      "description: $7",
      "---"
    ],
    "description": "AstroPaper 블로그 포스트 frontmatter 추가"
  },
  "Blog Template": {
    "scope": "markdown",
    "prefix": "template",
    "body": [
      "${1:frontmatter}",
      "",
      "${2:Introductory Sentence}",
      "",
      "## Table of contents",
      "",
      "## ${3:heading 1}"
    ],
    "description": "AstroPaper 블로그 포스트 기본 템플릿 추가"
  },
  "Blog Post Template": {
    "scope": "markdown",
    "prefix": "blog",
    "body": [
      "---",
      "title: $1",
      "author: psymon",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:${CURRENT_SECOND}+09:00",
      "modDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:${CURRENT_SECOND}+09:00",
      "slug: ${2:my-new-post}",
      "featured: ${3|false,true|}",
      "draft: ${4|false,true|}",
      "tags:",
      "  - ${5:tag}",
      "keywords:",
      "  - ${6:keyword}",
      "description: ${7:포스트 설명을 입력하세요}",
      "---",
      "",
      "## Table of contents",
      "",
      "## 들어가는 글",
      "",
      "$0"
    ],
    "description": "블로그 포스트 frontmatter와 기본 본문 템플릿 추가"
  }
}
